# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# The browser version, built by web/build-try.py. Not committed: the build is
# where the Supabase key gets injected, so a checked-in copy would be the one
# without it — downloaded, hosted, and silently collecting nothing.
try/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
dist-backend/

# Bare .env too — .env*.local above does not cover it, and it is exactly the
# file someone drops real Supabase keys into.
.env
